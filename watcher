def cmd_history(args) -> int:
    project = args.project if hasattr(args, "project") and args.project else ""
    limit = args.limit if hasattr(args, "limit") and args.limit else 20
    today_only = args.today if hasattr(args, "today") else False

    if not ARCHIVE_DIR.exists():
        print("No history yet.")
        return 0

    entries = []
    today_start = time.time() - (time.time() % 86400) if today_only else 0

    for d in sorted(ARCHIVE_DIR.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True):
        if not d.is_dir():
            continue
        pname = (d / "project_name").read_text().strip() if (d / "project_name").exists() else ""
        if project and pname.lower() != project.lower():
            continue

        archived_at_raw = (d / "archived_at").read_text().strip() if (d / "archived_at").exists() else "0"
        try:
            archived_at = float(archived_at_raw)
        except ValueError:
            archived_at = 0

        if today_only and archived_at < today_start:
            continue

        started_raw = (d / "started_at").read_text().strip() if (d / "started_at").exists() else "0"
        completed_raw = (d / "completed_at").read_text().strip() if (d / "completed_at").exists() else ""
        try:
            started = float(started_raw)
            completed = float(completed_raw) if completed_raw else started
            duration = completed - started
        except ValueError:
            duration = 0

        task = (d / "task").read_text().strip() if (d / "task").exists() else ""
        outcome = (d / "outcome").read_text().strip() if (d / "outcome").exists() else "completed"

        time_ago = _format_time_ago(archived_at)
        entries.append((pname, time_ago, _format_duration(duration), task, outcome))

        if len(entries) >= limit:
            break

    if not entries:
        print(f"No history{' for ' + project if project else ''}.")
        return 0

    title = f"History{' · ' + project if project else ''}"
    print(title)
    print()
    for pname, time_ago, duration, task, outcome in entries:
        emoji = {"completed": "✓", "killed": "💀", "expired": "🗑"}.get(outcome, "⚠️")
        task_short = task[:50] + ("…" if len(task) > 50 else "")
        prefix = f"  {pname:<16}" if not project else "  "
        print(f"{prefix}{emoji}  {time_ago:<15} {duration:<10} {task_short}")

    return 0


def _format_time_ago(ts: float) -> str:
    diff = time.time() - ts
    if diff < 3600:
        return f"{int(diff / 60)}min ago"
    if diff < 86400:
        h = int(diff / 3600)
        return f"{h}hr ago"
    if diff < 86400 * 2:
        return "Yesterday"
    return f"{int(diff / 86400)}d ago"


