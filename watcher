def _detect_telegram_chat_id(token: str, timeout: int = 30) -> int | None:
    """Poll getUpdates to detect the chat ID of the first message."""
    import urllib.request
    import urllib.parse
    url = f"https://api.telegram.org/bot{token}/getUpdates"
    start = time.time()
    while time.time() - start < timeout:
        try:
            with urllib.request.urlopen(url, timeout=5) as resp:
                data = json.loads(resp.read())
                for update in data.get("result", []):
                    msg = update.get("message", {})
                    if msg:
                        return msg.get("chat", {}).get("id")
        except Exception:
            pass
        time.sleep(2)
    return None


def _install_hooks() -> None:
    """Copy hook scripts to ~/.claude-watch/hooks/."""
    src_hooks = Path(__file__).parent / "hooks"
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)

    for hook in ("session-start.sh", "notify.sh", "stop.sh"):
        src = src_hooks / hook
        if src.exists():
            dest = HOOKS_DIR / hook
            shutil.copy2(src, dest)
            dest.chmod(0o755)

    # Copy send.py
    send_py_src = Path(__file__).parent / "src" / "send.py"
    if send_py_src.exists():
        send_py_dest = WATCH_DIR / "send.py"
        shutil.copy2(send_py_src, send_py_dest)
        send_py_dest.chmod(0o755)

    # Update shebang in send.py to use correct python
    send_py_dest = WATCH_DIR / "send.py"
    if send_py_dest.exists():
        content = send_py_dest.read_text()
        content = content.replace(
            "#!/usr/bin/env python3",
            f"#!{sys.executable}",
        )
        send_py_dest.write_text(content)


def _install_claude_hooks() -> None:
    """Add watcher hooks to ~/.claude/settings.json."""
    claude_dir = Path.home() / ".claude"
    claude_dir.mkdir(parents=True, exist_ok=True)
    settings_path = claude_dir / "settings.json"

    if settings_path.exists():
        try:
            with open(settings_path) as f:
                settings = json.load(f)
        except (json.JSONDecodeError, OSError):
            settings = {}
    else:
        settings = {}

    hooks_dir = str(HOOKS_DIR)
    settings.setdefault("hooks", {})

    for event, script in [
        ("SessionStart", "session-start.sh"),
        ("Notification", "notify.sh"),
        ("Stop", "stop.sh"),
    ]:
        hook_cmd = str(HOOKS_DIR / script)
        timeout = 5 if event == "SessionStart" else 10
        settings["hooks"][event] = [{
            "matcher": "",
            "hooks": [{
                "type": "command",
                "command": hook_cmd,
                "timeout": timeout,
            }],
        }]

    with open(settings_path, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")


def _install_launchagent() -> None:
    """Install the LaunchAgent plist."""
    LAUNCHAGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)

    watcherd_bin = shutil.which("watcherd") or str(SRC_DIR / "watcherd.py")

    plist = PLIST_TEMPLATE.format(
        watcherd_bin=watcherd_bin,
        enabled_flag=str(ENABLED_FLAG),
        log_out=str(LOGS_DIR / "watcherd.log"),
        log_err=str(LOGS_DIR / "watcherd-error.log"),
    )
    LAUNCHAGENT_PLIST.write_text(plist)


# ─── Argument parser ────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="watcher",
        description="Remote control Claude Code via iMessage and Telegram",
    )
    sub = parser.add_subparsers(dest="command")

    # start
    p_start = sub.add_parser("start", help="Start the daemon")
    p_start.add_argument("--imessage", action="store_true")
    p_start.add_argument("--telegram", action="store_true")
    p_start.add_argument("--no-imessage", action="store_true", dest="no_imessage")
    p_start.add_argument("--no-telegram", action="store_true", dest="no_telegram")

    # stop / restart
    sub.add_parser("stop", help="Stop the daemon")
    sub.add_parser("restart", help="Restart the daemon")

    # status / sessions
    sub.add_parser("status", help="Show daemon state and sessions")
    p_sessions = sub.add_parser("sessions", help="Manage sessions")
    sessions_sub = p_sessions.add_subparsers(dest="sessions_cmd")
    sessions_sub.add_parser("list")
    p_kill = sessions_sub.add_parser("kill")
    p_kill.add_argument("session_name")
    sessions_sub.add_parser("clean")

    # notify
    p_notify = sub.add_parser("notify", help="Toggle notifications")
    p_notify.add_argument("notify_action", choices=["on", "off", "imessage", "telegram"],
                          nargs="?", default="on")
    p_notify.add_argument("session_name", nargs="?", default="")

    # recent / history
    sub.add_parser("recent", help="Show recent sessions")
    p_history = sub.add_parser("history", help="Show session history")
    p_history.add_argument("project", nargs="?", default="")
    p_history.add_argument("--today", action="store_true")
    p_history.add_argument("--limit", type=int, default=20)

    # utility
    sub.add_parser("config", help="Open config in $EDITOR")
    sub.add_parser("logs", help="Tail daemon logs")
    sub.add_parser("install", help="Run first-time setup wizard")
    sub.add_parser("doctor", help="Check dependencies and configuration")

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        return 0

    dispatch = {
        "start": cmd_start,
        "stop": cmd_stop,
        "restart": cmd_restart,
        "status": cmd_status,
        "sessions": cmd_sessions,
        "notify": cmd_notify,
        "recent": cmd_recent,
        "history": cmd_history,
        "config": cmd_config,
        "logs": cmd_logs,
        "install": cmd_install,
        "doctor": cmd_doctor,
    }

    handler = dispatch.get(args.command)
    if handler:
        return handler(args)

    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
