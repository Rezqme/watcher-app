def cmd_doctor(args) -> int:
    """Check dependencies, permissions, and configuration."""
    print("watcher doctor\n")
    all_ok = True
    auto_fixed = 0

    def check(label: str, ok: bool, fix_fn=None, fix_label: str = "") -> bool:
        nonlocal auto_fixed, all_ok
        if ok:
            print(f"  ✓ {label}")
            return True
        else:
            print(f"  ✗ {label}")
            if fix_fn:
                print(f"    → Auto-fixing... ", end="", flush=True)
                try:
                    fix_fn()
                    print("✓ fixed")
                    auto_fixed += 1
                    return True
                except Exception as e:
                    print(f"✗ failed: {e}")
            all_ok = False
            return False

    # Dependencies
    check("imsg found", bool(shutil.which("imsg")))
    check("claude found", bool(shutil.which("claude")))
    check("jq found", bool(shutil.which("jq")))
    check("python3 found", bool(shutil.which("python3")))

    # Try httpx
    try:
        import httpx
        check("httpx installed", True)
    except ImportError:
        check("httpx installed", False)

    # Directories
    check("~/.claude-watch/ exists", WATCH_DIR.exists(),
          lambda: ensure_dirs(), "creating directory")
    check("sessions/ exists", SESSIONS_DIR.exists(),
          lambda: SESSIONS_DIR.mkdir(parents=True, exist_ok=True))
    check("logs/ exists", LOGS_DIR.exists(),
          lambda: LOGS_DIR.mkdir(parents=True, exist_ok=True))

    # Hook scripts
    for hook in ("session-start.sh", "notify.sh", "stop.sh"):
        hook_path = HOOKS_DIR / hook
        check(f"{hook} exists", hook_path.exists())
        if hook_path.exists():
            check(f"{hook} is executable", os.access(hook_path, os.X_OK),
                  lambda p=hook_path: p.chmod(0o755), "fixing permissions")

    # Config
    from config import CONFIG_PATH, PROJECTS_PATH
    check("config.json exists", CONFIG_PATH.exists())
    check("projects.json exists", PROJECTS_PATH.exists())

    # Telegram config
    config = load_config()
    tg = config.get("telegram", {})
    if tg.get("enabled"):
        check("Telegram token set", bool(tg.get("token")))
        check("Telegram chat_id set", bool(tg.get("chat_id")))

    # iMessage config
    im = config.get("imessage", {})
    if im.get("enabled"):
        check("iMessage 'to' set", bool(im.get("to")))

    # LaunchAgent
    if sys.platform == "darwin":
        check("LaunchAgent installed", LAUNCHAGENT_PLIST.exists())

    # Claude Code hooks
    claude_settings = Path.home() / ".claude" / "settings.json"
    if claude_settings.exists():
        try:
            with open(claude_settings) as f:
                settings = json.load(f)
            hooks = settings.get("hooks", {})
            check("SessionStart hook configured", "SessionStart" in hooks)
            check("Notification hook configured", "Notification" in hooks)
            check("Stop hook configured", "Stop" in hooks)
        except (json.JSONDecodeError, OSError):
            check("settings.json readable", False)
    else:
        print("  ✗ ~/.claude/settings.json not found — run 'watcher install' to configure")
        all_ok = False

    print()
    if all_ok:
        suffix = f" ({auto_fixed} auto-fixed)" if auto_fixed else ""
        print(f"  ✓ All checks passed{suffix}")
    else:
        print("  Some issues need manual attention. See above.")
    return 0 if all_ok else 1


