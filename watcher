def cmd_start(args) -> int:
    ensure_dirs()

    # Determine which channels to activate
    config = load_config()
    all_configured = []
    if config.get("imessage", {}).get("enabled"):
        all_configured.append("imessage")
    if config.get("telegram", {}).get("enabled"):
        all_configured.append("telegram")

    channels = list(all_configured)

    if args.imessage:
        channels = ["imessage"]
    elif args.telegram:
        channels = ["telegram"]
    elif args.no_imessage:
        channels = [c for c in channels if c != "imessage"]
    elif args.no_telegram:
        channels = [c for c in channels if c != "telegram"]

    if not channels:
        print("Warning: no channels configured. Run 'watcher install' first.")

    set_active_channels(channels)
    set_enabled(True)

    # Try launchctl first (macOS)
    if shutil.which("launchctl") and LAUNCHAGENT_PLIST.exists():
        subprocess.run(
            ["launchctl", "load", str(LAUNCHAGENT_PLIST)],
            capture_output=True,
        )
        print(f"Watcher started — channels: {', '.join(channels) or 'none'}")
        return 0

    # Fallback: start daemon directly
    watcherd = shutil.which("watcherd") or str(SRC_DIR / "watcherd.py")
    log_out = LOGS_DIR / "watcherd.log"
    log_err = LOGS_DIR / "watcherd-error.log"

    with open(log_out, "a") as out, open(log_err, "a") as err:
        proc = subprocess.Popen(
            [sys.executable, watcherd],
            stdout=out,
            stderr=err,
            start_new_session=True,
        )
    pid_file = WATCH_DIR / "daemon.pid"
    pid_file.write_text(str(proc.pid) + "\n")
    print(f"Watcher started (pid {proc.pid}) — channels: {', '.join(channels) or 'none'}")
    return 0


def cmd_stop(args) -> int:
    set_enabled(False)

    if shutil.which("launchctl") and LAUNCHAGENT_PLIST.exists():
        subprocess.run(
            ["launchctl", "unload", str(LAUNCHAGENT_PLIST)],
            capture_output=True,
        )
        print("Watcher stopped.")
        return 0

    pid = _read_pid()
    if pid:
        try:
            os.kill(pid, 15)
            print(f"Watcher stopped (pid {pid}).")
        except ProcessLookupError:
            print("Watcher was not running.")
    else:
        print("Watcher was not running.")
    return 0


def cmd_restart(args) -> int:
    cmd_stop(args)
    time.sleep(1)
    return cmd_start(args)


def cmd_status(args) -> int:
    running = _is_daemon_running() or (is_enabled() and shutil.which("launchctl"))
    status_str = "RUNNING" if running else "STOPPED"
    pid = _read_pid()
    pid_str = f" (pid {pid})" if pid else ""
    print(f"Watcher status: {status_str}{pid_str}")

    channels = get_active_channels()
    config = load_config()

    channel_descs = []
    if "imessage" in channels:
        to = config.get("imessage", {}).get("to", "")
        channel_descs.append(f"iMessage ({to})" if to else "iMessage")
    if "telegram" in channels:
        chat = config.get("telegram", {}).get("chat_id", "")
        channel_descs.append(f"Telegram (chat {chat})" if chat else "Telegram")

    print(f"Channels: {', '.join(channel_descs) if channel_descs else 'none'}")
    print(f"Timeout: {config.get('timeout_minutes', 30)}min")
    print()

    active = session_manager.active()
    parked = session_manager.parked()
    all_sessions = active + parked

    if all_sessions:
        print(f"Sessions ({len(all_sessions)}):")
        for s in all_sessions:
            status_emoji = "🟢" if s.status == "active" else "🟡"
            elapsed = _format_duration(s.elapsed_seconds)
            channels_label = _channel_label(s)
            task_short = s.task[:40] + ("…" if len(s.task) > 40 else "")
            print(f"  {status_emoji} {s.project_name:<16} {s.status:<8} {elapsed:<8} {channels_label:<16} {task_short}")
    else:
        print("Sessions: none")

    # Pending conversations
    conv_count = 0
    if CONVERSATIONS_DIR.exists():
        conv_count = sum(1 for d in CONVERSATIONS_DIR.iterdir() if d.is_dir())
    if conv_count:
        print(f"\nConversations: {conv_count} pending")

    return 0


def cmd_sessions(args) -> int:
    sub = args.sessions_cmd if hasattr(args, "sessions_cmd") else "list"

    if sub == "list" or sub is None:
        return cmd_status(args)

    elif sub == "kill":
        name = args.session_name if hasattr(args, "session_name") else ""
        if not name:
            print("Usage: watcher sessions kill <name>")
            return 1
        sessions = session_manager.find_by_name(name)
        if not sessions:
            print(f"No session found for '{name}'")
            return 1
        for s in sessions:
            ok = session_manager.kill(s.session_id)
            if ok:
                print(f"Killed: {s.project_name}")
            else:
                print(f"Failed to kill: {s.project_name}")
        return 0

    elif sub == "clean":
        count = session_manager.clean()
        print(f"Cleaned {count} completed session(s).")
        return 0

    return 1


def cmd_notify(args) -> int:
    action = args.notify_action if hasattr(args, "notify_action") else "on"
    name = args.session_name if hasattr(args, "session_name") else ""

    # Find target sessions
    if name:
        sessions = session_manager.find_by_name(name)
        if not sessions:
            print(f"No session found for '{name}'")
            return 1
    else:
        sessions = session_manager.active() + session_manager.parked()
        if not sessions:
            print("No active sessions.")
            return 0
        if len(sessions) > 1:
            print("Active sessions:")
            for i, s in enumerate(sessions, 1):
                print(f"  {i} · {s.project_name} — {_channel_label(s)}")
            print("\nSpecify a session name: watcher notify <action> <name>")
            return 0

    for s in sessions:
        if action == "on":
            session_manager.set_channel(s.session_id, "imessage", True)
            session_manager.set_channel(s.session_id, "telegram", True)
            print(f"🔔 {s.project_name}: notifications ON (both channels)")
        elif action == "off":
            session_manager.set_channel(s.session_id, "imessage", False)
            session_manager.set_channel(s.session_id, "telegram", False)
            print(f"🔕 {s.project_name}: notifications OFF")
        elif action == "imessage":
            current = s.notify_imessage
            session_manager.set_channel(s.session_id, "imessage", not current)
            state = "OFF" if current else "ON"
            print(f"🔔 {s.project_name}: iMessage {state}")
        elif action == "telegram":
            current = s.notify_telegram
            session_manager.set_channel(s.session_id, "telegram", not current)
            state = "OFF" if current else "ON"
            print(f"🔔 {s.project_name}: Telegram {state}")

    return 0


